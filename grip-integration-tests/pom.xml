<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.grip</groupId>
        <artifactId>grip-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>grip-integration-tests</artifactId>
    <name>grip-integration-tests</name>
    <description>End-to-end tests: HTTP client -> Controller -> Agent -> trivial internal service</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.grip</groupId>
            <artifactId>grip-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.grip</groupId>
            <artifactId>grip-controller</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.grip</groupId>
            <artifactId>grip-agent</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Trust only the checked-in GRIP test CA. The end-to-end
                             tests connect the Agent to a Controller using the test
                             keystore; the Agent still does full default-trust-manager
                             validation, it just trusts this store. -->
                        <javax.net.ssl.trustStore>${project.basedir}/src/test/resources/tls/truststore.p12</javax.net.ssl.trustStore>
                        <javax.net.ssl.trustStorePassword>changeit</javax.net.ssl.trustStorePassword>
                        <javax.net.ssl.trustStoreType>PKCS12</javax.net.ssl.trustStoreType>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
